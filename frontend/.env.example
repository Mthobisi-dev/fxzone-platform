# FxZone Environment Variables Example
# Copy this file to .env.local and fill in your values.

# Supabase Public Configuration (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Supabase Server Service Role Key (Required only when deliberately using
# the legacy Next.js API route handlers)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server-only FastAPI URL. Set this in local development and in the frontend
# host's environment to route every /api/* request to backend/. Leave it blank
# only when deliberately using the legacy Next.js route handlers.
BACKEND_URL=http://localhost:8000

# WebRTC TURN Server Configuration (Optional, for production WebRTC video calls)
NEXT_PUBLIC_TURN_URL=turn:your-turn-server.com:3478
NEXT_PUBLIC_TURN_USERNAME=your-turn-username
NEXT_PUBLIC_TURN_CREDENTIAL=your-turn-password

# Optional AI Assistance API Keys (used by legacy Next.js routes only)
GEMINI_API_KEY=your-gemini-api-key
