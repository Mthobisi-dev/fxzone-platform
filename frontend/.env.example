# FxZone Environment Variables Example
# Copy this file to .env.local and fill in your values.

# Supabase Public Configuration (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Supabase Server Service Role Key (required by Next.js server-side API routes).
# `SUPABASE_SECRET_KEY` is also accepted for Supabase's newer secret API key.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# WebRTC TURN Server Configuration (Optional, for production WebRTC video calls)
NEXT_PUBLIC_TURN_URL=turn:your-turn-server.com:3478
NEXT_PUBLIC_TURN_USERNAME=your-turn-username
NEXT_PUBLIC_TURN_CREDENTIAL=your-turn-password

# Optional AI Assistance API Keys
GEMINI_API_KEY=your-gemini-api-key
