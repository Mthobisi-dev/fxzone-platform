# FxZone environment variables
# Copy to .env.local for development. Configure the same keys in Vercel.
# Never commit real values. Only NEXT_PUBLIC_* values are available in the browser.

# Public Supabase configuration (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anonymous keys remain supported during Supabase key migration, but new
# deployments should use NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only configuration (required for trusted Next.js route handlers)
SUPABASE_SERVICE_ROLE_KEY=

# Optional server-only AI integration
GEMINI_API_KEY=

# Optional WebRTC TURN REST credentials. The shared secret must never use a
# NEXT_PUBLIC_ name and must remain only in the server environment.
TURN_URL=
TURN_SHARED_SECRET=
TURN_TTL_SECONDS=3600
