# ── Runtime ──────────────────────────────────────────────────────────────────
ENVIRONMENT=production                # development | test | production (production enforces the safety checks below)
LOG_LEVEL=INFO
CORS_ORIGINS=https://your-frontend.vercel.app      # comma separated; never '*'. Not needed when the frontend proxies via BACKEND_URL
TRUST_PROXY_HEADERS=true              # only if you sit behind a proxy YOU control (used for per-IP rate limits)

# ── Database: Supabase → Project Settings → Database → connection string ───
# Transaction pooler (port 6543) is supported (prepared statements are disabled). Use the direct/session string for migrations.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_SSL=verify-full              # require | verify-full (disable is refused in production)
DATABASE_SSL_ROOT_CERT=/etc/ssl/supabase-ca.crt    # download "SSL certificate" from the Supabase dashboard
DB_POOL_MAX=10

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # SECRET. Storage uploads, Realtime broadcast, account deletion. Never expose to the browser.
SUPABASE_JWT_SECRET=                  # ONLY for legacy HS256 projects. Leave empty on projects using asymmetric signing keys (JWKS is used).

# ── Redis (required in production unless ALLOW_IN_MEMORY_STATE=true on a SINGLE instance) ──
REDIS_URL=redis://default:<password>@<host>:6379
ALLOW_IN_MEMORY_STATE=false

# ── Uploads ─────────────────────────────────────────────────────────────────
STORAGE_BACKEND=supabase              # bucket `post-media` must exist (created by supabase_schema.sql)
MAX_UPLOAD_BYTES=26214400

# ── Optional features ───────────────────────────────────────────────────────
GEMINI_API_KEY=                       # narrates computed indicators; without it deterministic text is used
GEMINI_MODEL=gemini-2.5-flash         # check current model names in Google's docs
NEWS_FEEDS=Yahoo Finance|https://finance.yahoo.com/news/rssindex,CoinDesk|https://www.coindesk.com/arc/outboundfeeds/rss/
ENABLE_BACKGROUND_TASKS=true          # price refresh + broadcast, news ingest, housekeeping (leader-elected via Redis)
