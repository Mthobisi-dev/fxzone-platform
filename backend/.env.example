# ──────────────────────────────────────────────
# FxZone Backend — Environment Variables
# Copy this file to .env and fill in real values
# ──────────────────────────────────────────────

# PostgreSQL (Render provides this)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Redis
REDIS_URL=redis://localhost:6379

# MongoDB (optional)
MONGODB_URL=mongodb://localhost:27017

# JWT Auth — CHANGE THIS in production!
SECRET_KEY=fxzone-super-secret-key-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase (optional — for Google OAuth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# CORS — add your Vercel URL here
CORS_ORIGINS=["http://localhost:3000","https://fxzone-platform-4dqe.vercel.app"]

# App environment
APP_ENV=production

# AI Keys (optional)
GEMINI_API_KEY=your-gemini-api-key

# Market Data (optional)
ALPHA_VANTAGE_KEY=your-alpha-vantage-key
FINNHUB_KEY=your-finnhub-key
