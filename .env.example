# ──────────────────────────────────────────────
# FxZone Platform — Environment Configuration Template
# Copy this file to .env for local setup
# DO NOT commit real API secrets or private keys to source control!
# ──────────────────────────────────────────────

# ── App Environment ───────────────────────────
APP_ENV=development # Options: development, production

# ── PostgreSQL Database ───────────────────────
DATABASE_URL=postgresql+asyncpg://fxzone:fxzone@localhost:5432/fxzone
SUPABASE_DATABASE_URL=postgresql+asyncpg://postgres:password@db.supabase.co:5432/postgres

# ── Redis Cache & Realtime Pub/Sub ────────────
REDIS_URL=redis://localhost:6379

# ── MongoDB Document Store ────────────────────
MONGODB_URL=mongodb://localhost:27017

# ── Authentication & Cryptography ─────────────
SECRET_KEY=change-this-to-a-secure-random-64-char-hex-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Supabase Auth Integration ─────────────────
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── CORS Origins ──────────────────────────────
CORS_ORIGINS=["http://localhost:3000","https://fxzone-platform.vercel.app"]

# ── AI & Market Data Providers (Optional) ──────
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
ALPHA_VANTAGE_KEY=your-alpha-vantage-key
FINNHUB_KEY=your-finnhub-key

# ── WebRTC & TURN Relays (Optional) ────────────
NEXT_PUBLIC_TURN_URL=turn:turn.fxzone.io:3478
NEXT_PUBLIC_TURN_USERNAME=fxzone_user
NEXT_PUBLIC_TURN_CREDENTIAL=fxzone_secret_key
