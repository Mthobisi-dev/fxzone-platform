# ──────────────────────────────────────────────
# FxZone Platform — Supabase-Only Architecture Environment Template
# Copy this file to .env or .env.local for local setup
# DO NOT commit real API secrets or private keys to source control!
# ──────────────────────────────────────────────

# ── PUBLIC CLIENT-SIDE VARIABLES (NEXT_PUBLIC_*) ──
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional WebRTC TURN Server Relay credentials
NEXT_PUBLIC_TURN_URL=turn:turn.fxzone.io:3478
NEXT_PUBLIC_TURN_USERNAME=fxzone_user
NEXT_PUBLIC_TURN_CREDENTIAL=fxzone_secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── SERVER-ONLY SECRETS (Never expose via NEXT_PUBLIC_*) ──
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
GEMINI_API_KEY=your-gemini-api-key
